{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyUnapprovedInternetGatewaysAndVpcPeering",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:CreateVpcPeeringConnection",
        "ec2:AcceptVpcPeeringConnection"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalTag/NetworkAdminApproved": "true"
        },
        "ArnNotLike": {
          "aws:PrincipalARN": [
            "arn:aws:iam::*:role/AWSControlTowerExecution",
            "arn:aws:iam::*:role/NetworkAdministratorRole"
          ]
        }
      }
    }
  ]
}
